---
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

interface Related {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  date: string;
  dateLabel: string;
  readingTime: string;
  related?: Related[];
}

const { title, description, path, date, dateLabel, readingTime, related = [] } = Astro.props;
const iso = new Date(date).toISOString();
---

<Base title={title} description={description} path={path} image="/og.png">
  <div class="container-page py-10">
    <div class="mx-auto max-w-3xl">
      <Breadcrumbs items={[{ label: "Guides", href: "/blog" }, { label: title }]} />

      <header class="mt-8">
        <p class="eyebrow">Guide</p>
        <h1 class="mt-3 text-display-lg">{title}</h1>
        <div class="mt-4 flex items-center gap-3 text-caption text-mute">
          <time datetime={iso}>{dateLabel}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime} read</span>
        </div>
      </header>

      <article class="prose-doc mt-10">
        <slot />
      </article>

      <div class="mt-14 rounded-2xl border border-hairline bg-soft p-6 sm:p-8">
        <p class="eyebrow">Ready to try it?</p>
        <h2 class="mt-2 text-display-md">Identify a font from an image, free</h2>
        <p class="mt-2 text-body-md text-body">
          Upload or paste a screenshot and get the matching free font — with copy-paste CSS — in seconds. Everything runs
          in your browser.
        </p>
        <a href="/#identify" class="mt-5 inline-block rounded-sm bg-primary px-5 py-3 text-body-md font-medium text-on-primary transition-opacity hover:opacity-90">
          Open the font finder
        </a>
      </div>

      {related.length > 0 && (
        <nav class="mt-12" aria-label="Related guides">
          <p class="eyebrow">More guides</p>
          <div class="mt-3 flex flex-col gap-2">
            {related.map((r) => (
              <a href={r.href} class="text-body-md text-link hover:underline">
                {r.label} →
              </a>
            ))}
          </div>
        </nav>
      )}
    </div>
  </div>
</Base>