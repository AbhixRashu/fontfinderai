---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE, HOST, SITE_NAME } from "../data/site";
---

<Base
  title="Terms of Service"
  description="The terms for using Font Finder AI: free use of the identification tool, font licensing handled by Google Fonts, and limitation of liability."
  path="/terms"
  image="/og.png"
>
  <div class="container-page py-10">
    <div class="mx-auto max-w-3xl">
      <Breadcrumbs items={[{ label: "Terms" }]} />

      <header class="mt-8">
        <p class="eyebrow">Legal</p>
        <h1 class="mt-3 text-display-lg">Terms of service</h1>
        <p class="mt-3 text-caption text-mute">Last updated: January 2026</p>
      </header>

      <article class="prose-doc mt-8">
        <p>
          These terms govern your use of {SITE_NAME} ({HOST}). By using the service you agree to them. If you do not agree,
          please don't use the service.
        </p>

        <h2>The service</h2>
        <p>
          {SITE_NAME} is a free, browser-based font identification tool. It identifies typefaces from images you provide,
          suggests free alternatives to commercial fonts, and links to open-source Google Fonts. Identification runs locally
          in your browser.
        </p>

        <h2>Acceptable use</h2>
        <p>You agree not to:</p>
        <ul>
          <li>attempt to disrupt, overload, or probe the site or its infrastructure;</li>
          <li>scrape or bulk-download the site in a way that impairs it for other users;</li>
          <li>use the service for any unlawful purpose; or</li>
          <li>misrepresent that a matched free font is identical to a commercial original.</li>
        </ul>

        <h2>Font licences</h2>
        <p>
          The fonts referenced on this site are third-party open-source typefaces distributed by
          <a href="https://fonts.google.com" rel="noopener">Google Fonts</a>, each under its own licence (generally the SIL
          Open Font License). We do not distribute font files. Before commercial use of any font, review the licence shown
          on its Google Fonts specimen page and on the individual font page here. Free-alternative suggestions are
          recommendations of visual similarity, not guarantees of licensing outcomes.
        </p>

        <h2>No warranty</h2>
        <p>
          The service is provided "as is" and "as available" without warranties of any kind, express or implied, including
          accuracy of font identification, fitness for a particular purpose, or uninterrupted availability. Identification
          results are estimates and may be incorrect.
        </p>

        <h2>Limitation of liability</h2>
        <p>
          To the maximum extent permitted by law, {SITE_NAME} and its operators are not liable for any indirect, incidental,
          special, or consequential damages arising from your use of, or inability to use, the service.
        </p>

        <h2>Intellectual property</h2>
        <p>
          The site's own content and code are provided for general use; the typefaces remain the property of their
          respective authors under their licences.
        </p>

        <h2>Changes and termination</h2>
        <p>
          We may change these terms, or suspend or discontinue any part of the service, at any time. Continued use after
          changes constitutes acceptance of the updated terms.
        </p>

        <h2>Contact</h2>
        <p>
          Questions about these terms? <a href="/contact">Contact us</a>.
        </p>
      </article>
    </div>
  </div>
</Base>