---
import Logo from "./Logo.astro";
---
<footer class="mt-24 border-t border-hairline bg-canvas">
  <div class="container-page py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      <div class="lg:col-span-1">
        <Logo text={false} />
        <p class="mt-2 max-w-xs text-body-sm text-body">Identify any font from an image, then find a free alternative you can actually use.</p>
      </div>
      <div>
        <p class="eyebrow">Identify</p>
        <ul class="mt-3 space-y-2">
          <li><a href="/" class="text-body-sm text-body transition-colors hover:text-ink">Font finder</a></li>
          <li><a href="/tools/logo-font-identifier" class="text-body-sm text-body transition-colors hover:text-ink">Logo font identifier</a></li>
          <li><a href="/tools/screenshot-font-finder" class="text-body-sm text-body transition-colors hover:text-ink">Screenshot font finder</a></li>
          <li><a href="/tools/handwriting-font-finder" class="text-body-sm text-body transition-colors hover:text-ink">Handwriting font finder</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Browse</p>
        <ul class="mt-3 space-y-2">
          <li><a href="/fonts" class="text-body-sm text-body transition-colors hover:text-ink">Free font library</a></li>
          <li><a href="/fonts?category=serif" class="text-body-sm text-body transition-colors hover:text-ink">Serif fonts</a></li>
          <li><a href="/fonts?category=sans-serif" class="text-body-sm text-body transition-colors hover:text-ink">Sans-serif fonts</a></li>
          <li><a href="/font-alternatives" class="text-body-sm text-body transition-colors hover:text-ink">Free font alternatives</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Learn</p>
        <ul class="mt-3 space-y-2">
          <li><a href="/blog" class="text-body-sm text-body transition-colors hover:text-ink">Guides</a></li>
          <li><a href="/faq" class="text-body-sm text-body transition-colors hover:text-ink">FAQ</a></li>
          <li><a href="/identify/netflix-font" class="text-body-sm text-body transition-colors hover:text-ink">Brand font guides</a></li>
          <li><a href="/about" class="text-body-sm text-body transition-colors hover:text-ink">About</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Legal</p>
        <ul class="mt-3 space-y-2">
          <li><a href="/privacy" class="text-body-sm text-body transition-colors hover:text-ink">Privacy</a></li>
          <li><a href="/terms" class="text-body-sm text-body transition-colors hover:text-ink">Terms</a></li>
          <li><a href="/contact" class="text-body-sm text-body transition-colors hover:text-ink">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-2 border-t border-hairline pt-6 text-caption text-mute sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; 2026 Font Finder AI. Free to use, no account needed.</p>
      <p>Font data from the <a href="https://fonts.google.com" rel="noopener" class="text-link hover:underline">Google Fonts</a> open-source catalogue.</p>
    </div>
  </div>
</footer>
