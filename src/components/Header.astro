---
import Logo from "./Logo.astro";
const current = Astro.url.pathname;
const links = [
  { href: "/fonts", label: "Free fonts" },
  { href: "/tools", label: "Tools" },
  { href: "/blog", label: "Guides" },
  { href: "/faq", label: "FAQ" },
];
---

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-100 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-on-primary">Skip to content</a>
<header data-site-header transition:persist="site-header" class="glass-strong sticky top-0 z-50 border-b border-hairline">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <Logo href="/" class="rounded-md px-1" />

    <div class="flex items-center gap-6">
      <nav class="hidden items-center gap-6 md:flex" aria-label="Main">
        {links.map((l) => (
          <a
            href={l.href}
            aria-current={current === l.href || (l.href !== "/" && current.startsWith(l.href)) ? "page" : undefined}
            class="text-[15px] font-medium text-body transition-colors hover:text-ink aria-[current=page]:text-ink"
          >
            {l.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <button
          id="theme-toggle"
          type="button"
          class="grid size-9 cursor-pointer place-items-center rounded-full border border-hairline bg-soft/60 text-body transition-all hover:border-hairline-strong hover:bg-soft hover:text-ink"
          aria-label="Switch colour theme"
        >
          <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>
        <script is:inline>
          (() => {
            const btn = document.getElementById(`theme-toggle`);
            if (btn && !btn.dataset.bound) {
              btn.dataset.bound = `1`;
              btn.addEventListener(`click`, () => {
                const dark = document.documentElement.classList.toggle(`dark`);
                localStorage.setItem(`theme`, dark ? `dark` : `light`);
              });
            }
          })();
        </script>
        <a
          href="/#identify"
          class="rounded-lg bg-primary px-4 py-2 text-sm font-medium text-on-primary shadow-sm transition-all hover:opacity-90 active:scale-[0.98]"
        >
          Identify a font
        </a>
      </div>
    </div>
  </div>
  <nav class="container-page flex gap-2 overflow-x-auto pb-2.5 pt-1 md:hidden" aria-label="Mobile Main">
    {links.map((l) => (
      <a
        href={l.href}
        aria-current={current === l.href || (l.href !== "/" && current.startsWith(l.href)) ? "page" : undefined}
        class="shrink-0 rounded-full px-3.5 py-1.5 text-xs font-medium text-body transition-colors hover:bg-soft hover:text-ink aria-[current=page]:bg-soft aria-[current=page]:text-ink"
      >
        {l.label}
      </a>
    ))}
  </nav>
</header>
<script>
  const header = document.querySelector(`[data-site-header]`);
  if (header) {
    const set = () => document.documentElement.style.setProperty(`--header-height`, `${Math.round(header.getBoundingClientRect().height)}px`);
    set();
    new ResizeObserver(set).observe(header);
  }
</script>
